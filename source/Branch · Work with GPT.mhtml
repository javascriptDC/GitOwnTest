import time
import torch
import typing
import bittensor as bt
import numpy as np
from zeus.data.converter import get_converter
from zeus.utils.config import get_device_str
from zeus.utils.time import to_timestamp
from zeus.protocol import TimePredictionSynapse
# add these:
import datetime
from model_loader import ZeusModelLoader



class Miner(BaseMinerNeuron):
    """
    Your miner neuron class. You should use this class to define your miner=
's behavior.
    In particular, you should replace the forward function with your own lo=
gic.

    Currently the base miner does a request to OpenMeteo (https://open-mete=
o.com/) for predictions.
    You are encouraged to attempt to improve over this by changing the forw=
ard function.
    """

    def __init__(self, config=3DNone):
        super(Miner, self).__init__(config=3Dconfig)

        bt.logging.info("Attaching forward functions to miner axon.")
        self.axon.attach(
            forward_fn=3Dself.forward,
            blacklist_fn=3Dself.blacklist,
            priority_fn=3Dself.priority,
        )

         # path where your trained models live
        self.model_loader =3D ZeusModelLoader(
            models_root=3D"/root/zeus-trained/trained_models",  # &lt;-- ad=
just if needed
            context_hours=3D48,
            forecast_hours=3D24,
        )
       =20
        # TODO(miner): Anything specific to your use case you can do here
        self.device: torch.device =3D torch.device(get_device_str())
        self.openmeteo_api =3D openmeteo_requests.Client()

    async def forward(self, synapse: TimePredictionSynapse) -&gt; TimePredi=
ctionSynapse:
        """
        Processes the incoming TimePredictionSynapse for a prediction.

        Args:
            synapse (TimePredictionSynapse): The synapse object containing =
the time range and coordinates

        Returns:
            TimePredictionSynapse: The synapse object with the 'predictions=
' field set".
        """
        # shape (lat, lon, 2) so a grid of locations
        coordinates =3D torch.Tensor(synapse.locations)
        start_time =3D to_timestamp(synapse.start_time)
        end_time =3D to_timestamp(synapse.end_time)
        bt.logging.info(
            f"Received request! Predicting {synapse.requested_hours} hours =
of {synapse.variable} for grid of shape {coordinates.shape}."
        )

        ###################################################################=
#######################################
        # Improved baseline: use Open-Meteo ONLY for 48h history, then use =
our ML model for the forecast.
        latitudes, longitudes =3D coordinates.view(-1, 2).T
        converter =3D get_converter(synapse.variable)

        # 1) Build history window [start_time - 48h, start_time]
        ctx_hours =3D self.model_loader.context_hours  # 48
        history_start_dt =3D start_time - datetime.timedelta(hours=3Dctx_ho=
urs)
        history_end_dt =3D start_time

        history_params =3D {
            "latitude": latitudes.tolist(),
            "longitude": longitudes.tolist(),
            "hourly": converter.om_name,
            "start_hour": history_start_dt.isoformat(timespec=3D"minutes"),
            "end_hour": history_end_dt.isoformat(timespec=3D"minutes"),
        }

        history_responses =3D self.openmeteo_api.weather_api(
            "https://api.open-meteo.com/v1/forecast",
            params=3Dhistory_params,
            method=3D"POST",
        )

        # 2) Build tensor [T_hist, H, W] from history responses
        # each r.Hourly().Variables(0).ValuesAsNumpy() is [T_hist]
        hist_vals =3D np.stack(
            [
                history_responses[i].Hourly().Variables(0).ValuesAsNumpy()
                for i in range(len(history_responses))
            ],
            axis=3D0,  # [H*W, T_hist]
        )

        H, W =3D coordinates.shape[0], coordinates.shape[1]
        T_hist =3D hist_vals.shape[1]

        # ensure we have at least ctx_hours; take last ctx_hours
        if T_hist &lt; ctx_hours:
            raise RuntimeError(
                f"Not enough history hours: got {T_hist}, need {ctx_hours}"
            )

        hist_vals =3D hist_vals[:, -ctx_hours:]          # [H*W, 48]
        hist_vals =3D hist_vals.reshape(H, W, ctx_hours) # [H, W, 48]
        hist_vals =3D np.transpose(hist_vals, (2, 0, 1)) # [48, H, W]

        # 3) Convert Open-Meteo units to ERA5 units for the history
        hist_era5 =3D converter.om_to_era5(torch.tensor(hist_vals)).numpy()
        # ensure shape [48, H, W]
        if hist_era5.shape[0] !=3D ctx_hours:
            raise RuntimeError(f"Unexpected history shape after conversion:=
 {hist_era5.shape}")

