</span><span><span class=3D"hljs-comment"># Call Open-Meteo for past 48h</s=
pan></span><span>
params =3D {
    </span><span><span class=3D"hljs-string">"latitude"</span></span><span>=
: latitudes.tolist(),
    </span><span><span class=3D"hljs-string">"longitude"</span></span><span=
>: longitudes.tolist(),
