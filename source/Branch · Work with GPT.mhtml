def download_month(year: int, month: int, out_dir: str):
    """Download a single year-month into a NetCDF file."""
    file_name =3D f"era5_{year}_{month:02d}.nc"
    file_path =3D os.path.join(out_dir, file_name)

    if os.path.exists(file_path):
        print(f"[SKIP] {file_name} already exists.")
        return

    print(f"[INFO] Downloading ERA5 for {year}-{month:02d} ...")
    c =3D cdsapi.Client()

    # Retry mechanism (CDS sometimes drops connections)
    for attempt in range(5):
        try:
            c.retrieve(
                "reanalysis-era5-single-levels",
                {
                    "product_type": "reanalysis",
                    "format": "netcdf",
                    "variable": ZEUS_VARIABLES,
                    "year": str(year),
                    "month": f"{month:02d}",
                    "day": [f"{d:02d}" for d in range(1, 32)],
                    "time": [f"{h:02d}:00" for h in range(24)],
                },
                file_path,
            )
