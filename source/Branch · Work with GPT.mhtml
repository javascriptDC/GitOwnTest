<hr data-start=3D"2733" data-end=3D"2736">
<h1 data-start=3D"2738" data-end=3D"2798">=E2=9D=97 You do NOT need 3D pres=
sure-level ERA5 for Zeus baseline</h1>
<p data-start=3D"2800" data-end=3D"2815">Zeus evaluates:</p>
<ul data-start=3D"2817" data-end=3D"2916">
<li data-start=3D"2817" data-end=3D"2838">
<p data-start=3D"2819" data-end=3D"2838">2-meter variables</p>
</li>
<li data-start=3D"2839" data-end=3D"2858">
<p data-start=3D"2841" data-end=3D"2858">10m / 100m wind</p>
</li>
<li data-start=3D"2859" data-end=3D"2879">
<p data-start=3D"2861" data-end=3D"2879">surface pressure</p>
</li>
<li data-start=3D"2880" data-end=3D"2903">
<p data-start=3D"2882" data-end=3D"2903">total precipitation</p>
</li>
<li data-start=3D"2904" data-end=3D"2916">
<p data-start=3D"2906" data-end=3D"2916">dewpoint</p>
</li>
</ul>
<p data-start=3D"2918" data-end=3D"2952">Everything from <strong data-start=
=3D"2934" data-end=3D"2951">single-levels</strong>.</p>
<p data-start=3D"2954" data-end=3D"2985">This saves a lot of disk space.</p=
>
