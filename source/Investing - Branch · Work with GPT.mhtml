<li data-start=3D"645" data-end=3D"667">
<p data-start=3D"647" data-end=3D"667">temperature_2m (K)</p>
</li>
<li data-start=3D"668" data-end=3D"681">
<p data-start=3D"670" data-end=3D"681">u10 (m/s)</p>
</li>
<li data-start=3D"682" data-end=3D"695">
<p data-start=3D"684" data-end=3D"695">v10 (m/s)</p>
