#!/usr/bin/env python3
import argparse
import json
import os
import glob
import numpy as np
import xarray as xr
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from tqdm import tqdm


# -------------------------------
# ERA5 variable mappings
# -------------------------------
ERA5_VAR_MAP =3D {
    "2m_temperature": "t2m",
    "2m_dewpoint_temperature": "d2m",
    "100m_u_component_of_wind": "u100",
    "100m_v_component_of_wind": "v100",
    "surface_pressure": "sp",
    "total_precipitation": "tp",
}


TIME_DIM =3D "valid_time"


# -------------------------------
# Simple UNet-like CNN
# -------------------------------
class SimpleUNet(nn.Module):
    def __init__(self, in_channels, out_channels=3D24, hidden=3D64):
        super().__init__()

        self.enc1 =3D nn.Sequential(
            nn.Conv2d(in_channels, hidden, 3, padding=3D1),
            nn.ReLU(),
            nn.Conv2d(hidden, hidden, 3, padding=3D1),
            nn.ReLU(),
        )
        self.enc2 =3D nn.Sequential(
            nn.Conv2d(hidden, hidden * 2, 3, padding=3D1, stride=3D2),
            nn.ReLU(),
            nn.Conv2d(hidden * 2, hidden * 2, 3, padding=3D1),
            nn.ReLU(),
        )

        self.bottleneck =3D nn.Sequential(
            nn.Conv2d(hidden * 2, hidden * 2, 3, padding=3D1),
            nn.ReLU()
        )

        self.dec1 =3D nn.Sequential(
            nn.ConvTranspose2d(hidden * 2, hidden, 2, stride=3D2),
            nn.ReLU(),
            nn.Conv2d(hidden, hidden, 3, padding=3D1),
            nn.ReLU(),
        )

        self.final =3D nn.Conv2d(hidden, out_channels, 1)

    def forward(self, x):
        B, C, H, W =3D x.shape
        e1 =3D self.enc1(x)
        e2 =3D self.enc2(e1)
        b =3D self.bottleneck(e2)
        d1 =3D self.dec1(b)
        out =3D self.final(d1)

        # Fix shape to match original dimensions
        return out[..., :H, :W]


# -------------------------------
# ERA5 Dataset
# -------------------------------
class Era5ForecastDataset(Dataset):
    def __init__(self, files, variable, context_hours, forecast_hours):
        self.variable =3D variable
        self.context =3D context_hours
        self.forecast =3D forecast_hours

        print("[INFO] Loading dataset...")
        era5_var =3D ERA5_VAR_MAP[variable]

        self.ds =3D xr.open_mfdataset(
            files,
            combine=3D"by_coords",
            engine=3D"h5netcdf"
        )[era5_var]

        # Fix time dim
        self.ds =3D self.ds.sortby(TIME_DIM)

        # Remove ensemble/version
        if "number" in self.ds.dims:
            self.ds =3D self.ds.isel(number=3D0)
        if "expver" in self.ds.dims:
            self.ds =3D self.ds.isel(expver=3D0)

        # Convert to numpy
        self.values =3D self.ds.values.astype(np.float32)

        # Fix latitude size mismatch (721 =E2=86=92 720)
        self.values =3D self.values[:, :-1, :]

        self.T =3D self.values.shape[0]
        print(f"[INFO] Data loaded: time=3D{self.T}, lat=3D{self.values.sha=
pe[1]}, lon=3D{self.values.shape[2]}")

    def __len__(self):
        return self.T - self.context - self.forecast

    def __getitem__(self, idx):
        X =3D self.values[idx: idx + self.context]
        Y =3D self.values[idx + self.context: idx + self.context + self.for=
ecast]
        return torch.tensor(X), torch.tensor(Y)


# -------------------------------
# Training function (supports resume)
# -------------------------------
def train(variable, data_glob, output_dir,
          context_hours, forecast_hours,
          batch_size, epochs, lr, hidden,
          resume=3DNone, start_epoch_override=3DNone):

    print("[INFO] Finding ERA5 files...")
    files =3D sorted(glob.glob(data_glob))
    if not files:
        raise RuntimeError(f"No files found for: {data_glob}")
    print(f"[INFO] Using {len(files)} files for variable {variable}")

    # Dataset
    dataset =3D Era5ForecastDataset(
        files=3Dfiles,
        variable=3Dvariable,
        context_hours=3Dcontext_hours,
        forecast_hours=3Dforecast_hours,
    )

    # Normalization
    print("[INFO] Computing mean/std...")
    mean =3D float(np.nanmean(dataset.values))
    std =3D float(np.nanstd(dataset.values) + 1e-6)

    os.makedirs(output_dir, exist_ok=3DTrue)
    norm_path =3D os.path.join(output_dir, f"norm_{variable}.json")
    with open(norm_path, "w") as f:
        json.dump({"mean": mean, "std": std}, f)

    print(f"[OK] Saved normalization: {norm_path}")

    # Wrapper to normalize batches
    class NormWrapper(Dataset):
        def __init__(self, base): self.base =3D base
        def __len__(self): return len(self.base)
        def __getitem__(self, idx):
            X, Y =3D self.base[idx]
            return ( (X - mean) / std, (Y - mean) / std )

    loader =3D DataLoader(NormWrapper(dataset), batch_size=3Dbatch_size, sh=
uffle=3DTrue)

    # Device
    device =3D torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[INFO] Training on: {device}")

    # Model
    model =3D SimpleUNet(
        in_channels=3Dcontext_hours,
        out_channels=3Dforecast_hours,
        hidden=3Dhidden
    ).to(device)

    optim =3D torch.optim.Adam(model.parameters(), lr=3Dlr)
    loss_fn =3D nn.MSELoss()

    # -------------------------------
    # Resume logic
    # -------------------------------
    start_epoch =3D start_epoch_override

    if start_epoch &gt; 1:
        # Example: start_epoch =3D 4 =E2=86=92 load epoch 3
        prev_epoch =3D start_epoch - 1
        resume_path =3D os.path.join(
            output_dir,
            f"model_{variable}_epoch{prev_epoch}.pt"
        )

        if not os.path.exists(resume_path):
            raise RuntimeError(f"Checkpoint not found: {resume_path}")

        print(f"[INFO] Loading checkpoint: {resume_path}")
        ckpt =3D torch.load(resume_path, map_location=3Ddevice)

        if isinstance(ckpt, dict) and "model" in ckpt:
            print("[INFO] Resuming from NEW checkpoint format")
            model.load_state_dict(ckpt["model"])
            optim.load_state_dict(ckpt["optim"])
        else:
            print("[INFO] Resuming from OLD checkpoint format (weights only=
)")
            model.load_state_dict(ckpt)

    print(f"[INFO] Starting training from epoch: {start_epoch}")


    # -------------------------------
    # Training loop
    # -------------------------------
    for ep in range(start_epoch, start_epoch + epochs):
        model.train()
        losses =3D []

        for X, Y in loader:
            X, Y =3D X.to(device), Y.to(device)

            pred =3D model(X)
            loss =3D loss_fn(pred, Y)

            optim.zero_grad()
            loss.backward()
            optim.step()

            losses.append(loss.item())

        avg =3D sum(losses) / len(losses)
        print(f"[Epoch {ep}] loss=3D{avg:.6f}")

        # Save checkpoint
        ckpt_path =3D os.path.join(output_dir, f"model_{variable}_epoch{ep}=
.pt")
        torch.save({
            "epoch": ep,
            "model": model.state_dict(),
            "optim": optim.state_dict(),
        }, ckpt_path)

    # Final model
    final_path =3D os.path.join(output_dir, f"model_{variable}.pt")
    torch.save({
        "epoch": ep,
        "model": model.state_dict(),
        "optim": optim.state_dict(),
    }, final_path)
    print(f"[OK] Final model saved: {final_path}")


