=3D"hljs-string">"minutes"</span></span><span>)

converter =3D get_converter(synapse.variable)
om_var =3D converter.om_name

</span><span><span class=3D"hljs-comment"># Call Open-Meteo for past 48h</s=
pan></span><span>
params =3D {
    </span><span><span class=3D"hljs-string">"latitude"</span></span><span>=
: latitudes.tolist(),
    </span><span><span class=3D"hljs-string">"longitude"</span></span><span=
>: longitudes.tolist(),
    </span><span><span class=3D"hljs-string">"hourly"</span></span><span>: =
om_var,
    </span><span><span class=3D"hljs-string">"start_hour"</span></span><spa=
n>: history_start,
    </span><span><span class=3D"hljs-string">"end_hour"</span></span><span>=
: history_end
}

history_resp =3D self.openmeteo_api.weather_api(
    </span><span><span class=3D"hljs-string">"https://api.open-meteo.com/v1=
/forecast"</span></span><span>,
    params=3Dparams,
    method=3D</span><span><span class=3D"hljs-string">"POST"</span></span><=
span>
)

</span><span><span class=3D"hljs-comment"># -------------------------------=
----------------</span></span><span>
</span><span><span class=3D"hljs-comment"># STEP 2: Build tensor [48, H, W]=
</span></span><span>
</span><span><span class=3D"hljs-comment"># -------------------------------=
----------------</span></span><span>
