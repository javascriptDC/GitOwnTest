ce-pre-wrap">class TinyAgeNet(nn.Module):
    """Small CNN student model for SN2 circuit export."""

    def __init__(self, n_classes=3DNUM_CLASSES):
        super().__init__()
        self.conv1 =3D nn.Conv2d(3, 24, 3, stride=3D2, padding=3D1)
        self.conv2 =3D nn.Conv2d(24, 48, 3, stride=3D2, padding=3D1)
        self.conv3 =3D nn.Conv2d(48, 96, 3, stride=3D2, padding=3D1)

        self.fc1 =3D nn.Linear(96, 32)
        self.fc2 =3D nn.Linear(32, n_classes)

    def forward(self, x):
        x =3D F.relu(self.conv1(x))   # (24, 32, 32)
        x =3D F.relu(self.conv2(x))   # (48, 16, 16)
        x =3D F.relu(self.conv3(x))   # (96, 8, 8)
        # x =3D x.mean(dim=3D[2, 3])      # global avg pool =E2=86=92 (96)
        x =3D torch.mean(x, dim=3D(2, 3), keepdim=3DTrue)
        x =3D x.view(x.size(0), -1)   # flatten =E2=86=92 (96)
        x =3D F.relu(self.fc1(x))     # (32)
        return self.fc2(x)


