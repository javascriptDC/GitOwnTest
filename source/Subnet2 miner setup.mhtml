</li>
<li data-start=3D"2641" data-end=3D"2723">
<p data-start=3D"2644" data-end=3D"2694">Then <code data-start=3D"2649" dat=
a-end=3D"2658">get-srs</code> + <code data-start=3D"2661" data-end=3D"2668"=
>setup</code> again to produce <strong data-start=3D"2686" data-end=3D"2693=
">new</strong>:</p>
<ul data-start=3D"2699" data-end=3D"2723">
<li data-start=3D"2699" data-end=3D"2709">
<p data-start=3D"2701" data-end=3D"2709"><code data-start=3D"2701" data-end=
=3D"2709">vk.key</code></p>
</li>
