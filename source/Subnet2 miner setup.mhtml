def export_onnx(ckpt_path, onnx_path, image_size=3D64, device=3DNone):
    """Export TinyAgeNet to ONNX."""
    if device is None:
        device =3D torch.device("cpu")

    model =3D TinyAgeNet(NUM_CLASSES).to(device)
    data =3D torch.load(ckpt_path, map_location=3Ddevice)
    model.load_state_dict(data["model"])

    model.eval()
    dummy =3D torch.randn(1, 3, image_size, image_size, device=3Ddevice)

    os.makedirs(os.path.dirname(onnx_path), exist_ok=3DTrue)
    torch.onnx.utils._export =3D torch.onnx.export



    torch.onnx.export(
        model,
        dummy,
        onnx_path,
        input_names=3D["input"],
        output_names=3D["output"],
        opset_version=3D17,
        do_constant_folding=3DTrue,
        export_params=3DTrue,
        dynamic_axes=3DNone,
        operator_export_type=3Dtorch.onnx.OperatorExportTypes.ONNX,
    )

    print(f"Exported ONNX model =E2=86=92 {onnx_path}")

