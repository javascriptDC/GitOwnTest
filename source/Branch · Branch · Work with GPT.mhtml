# model_loader.py
import os
import json
from glob import glob

import numpy as np
import torch
from train_model import SimpleUNet  # make sure this import works


class ZeusModelLoader:
    """
    Loads trained models for each variable and provides
    a simple predict() interface for the miner.
    """

    def __init__(self, models_root, context_hours=3D48, forecast_hours=3D24=
, device=3DNone):
        self.models_root =3D models_root
        self.context_hours =3D context_hours
        self.forecast_hours =3D forecast_hours

        self.device =3D device or ("cuda" if torch.cuda.is_available() else=
 "cpu")
        print(f"[ModelLoader] Using device: {self.device}")

        self.models =3D {}   # variable -&gt; model
        self.norms =3D {}    # variable -&gt; {"mean": ..., "std": ...}

        self._load_all_models()

    def _load_all_models(self):
        print(f"[ModelLoader] Scanning {self.models_root} for models...")
        # looks for */model_&lt;var&gt;.pt
        for path in glob(os.path.join(self.models_root, "*/model_*.pt")):
            base =3D os.path.basename(path)
            if not base.startswith("model_") or not base.endswith(".pt"):
                continue

            varname =3D base[len("model_") : -len(".pt")]
            var_dir =3D os.path.dirname(path)
            print(f"[ModelLoader] Loading model for variable: {varname}")

            # build model with correct shapes
            model =3D SimpleUNet(
                in_channels=3Dself.context_hours,
                out_channels=3Dself.forecast_hours,
                hidden=3D64,
            ).to(self.device)

            state =3D torch.load(path, map_location=3Dself.device)
            model.load_state_dict(state)
            model.eval()

            # load normalization
            norm_path =3D os.path.join(var_dir, f"norm_{varname}.json")
            if not os.path.exists(norm_path):
                print(f"[WARN] Missing norm file for {varname}, skipping.")
                continue

            with open(norm_path, "r") as f:
                norms =3D json.load(f)
            mean =3D norms.get("mean")
            std =3D norms.get("std")
            if mean is None or std is None:
                print(f"[WARN] norm file incomplete for {varname}, skipping=
.")
                continue

            self.models[varname] =3D model
            self.norms[varname] =3D {"mean": float(mean), "std": float(std)=
}

        print(f"[ModelLoader] Loaded {len(self.models)} variables.")

    @torch.no_grad()
    def predict(self, variable: str, input_tensor: torch.Tensor) -&gt; np.n=
darray:
        """
        variable: e.g. "2m_temperature"
        input_tensor: torch.Tensor of shape [context_hours, H, W] in ERA5 u=
nits

        Returns: numpy array [forecast_hours, H, W] in ERA5 units
        """
        if variable not in self.models:
            raise ValueError(f"[ModelLoader] No model for variable '{variab=
le}'")

        model =3D self.models[variable]
        norm =3D self.norms[variable]
        mean =3D norm["mean"]
        std =3D norm["std"]

        # normalize
        x =3D (input_tensor - mean) / (std + 1e-6)
        x =3D x.unsqueeze(0).to(self.device)  # [1, C, H, W]

        # forward
        y =3D model(x)[0]  # [forecast_hours, H, W]

        # de-normalize
        y =3D y * (std + 1e-6) + mean
        return y.cpu().numpy()
