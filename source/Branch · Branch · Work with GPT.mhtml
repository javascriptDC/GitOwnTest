    # Using ZeunUnet instead of SimpleUnet
    model =3D ZeusUNet(
        in_channels=3Dcontext_hours,
        out_channels=3Dforecast_hours,
        base_channels=3D32,  # you can try 64 on big GPUs later
    ).to(device)

    optim =3D torch.optim.Adam(model.parameters(), lr=3Dlr)
   =20
    if variable =3D=3D "total_precipitation":
        loss_fn =3D torch.nn.SmoothL1Loss()
    else:
        loss_fn =3D torch.nn.MSELoss()

    # -------------------
    # Training loop
    # -------------------
    for ep in range(1, epochs + 1):
        model.train()
        losses =3D []

        for X, Y in loader:
            X, Y =3D X.to(device), Y.to(device)
            pred =3D model(X)

            loss =3D loss_fn(pred, Y)
            optim.zero_grad()
            loss.backward()
            optim.step()

            losses.append(loss.item())

        avg_loss =3D sum(losses) / len(losses)
        print(f"[Epoch {ep}/{epochs}] loss=3D{avg_loss:.6f}")

        # Save checkpoint
        ckpt_path =3D os.path.join(output_dir, f"model_{variable}_epoch{ep}=
.pt")
        torch.save(model.state_dict(), ckpt_path)

    # Save final model
    final_path =3D os.path.join(output_dir, f"model_{variable}.pt")
    torch.save(model.state_dict(), final_path)
    print(f"[OK] Final model saved: {final_path}")


