class Era5ForecastDataset(Dataset):
    def __init__(self, files, variable, context_hours, forecast_hours):
        self.variable =3D variable
        self.context =3D context_hours
        self.forecast =3D forecast_hours

        print("[INFO] Loading dataset...")
        era5_var =3D ERA5_VAR_MAP[variable]

        self.ds =3D xr.open_mfdataset(
            files,
            combine=3D"by_coords",
            engine=3D"netcdf4"
        )[era5_var]


        # Fix time dimension
        TIME_DIM =3D "valid_time"
        self.ds =3D self.ds.sortby(TIME_DIM)

        # Remove ERA5 ensemble and version dims
        if "number" in self.ds.dims:
            self.ds =3D self.ds.isel(number=3D0)

        if "expver" in self.ds.dims:
            self.ds =3D self.ds.isel(expver=3D0)

        # Convert to numpy array
