</li>
<li data-start=3D"1109" data-end=3D"1348">
<p data-start=3D"1111" data-end=3D"1156"><strong data-start=3D"1111" data-e=
nd=3D"1139">Specialization for winds</strong><br data-start=3D"1139" data-e=
nd=3D"1142">
