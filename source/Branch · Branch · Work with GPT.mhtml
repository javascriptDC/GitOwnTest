#!/usr/bin/env python3
"""
Train a Zeus weather model for a single ERA5 variable.
Supports:
- Advanced ZeusUNet (residual/GroupNorm UNet)
- log1p normalization for precipitation
- AMP mixed precision training
- AdamW optimizer with cosine annealing
- Gradient clipping
"""

import argparse
import json
import os
import glob
import numpy as np
import xarray as xr

import torch
import torch.nn as nn
from torch import amp
from torch.utils.data import Dataset, DataLoader
from tqdm import tqdm
import torch.nn.functional as F

# ---------------------------------------------
# Enable TF32 for faster tensor core operations
# ---------------------------------------------
torch.backends.cuda.matmul.allow_tf32 =3D True
torch.backends.cudnn.allow_tf32 =3D True


# -------------------------------------------------------------------------=
-----------
# ERA5 VARIABLE NAME MAPPING
# -------------------------------------------------------------------------=
-----------
ERA5_VAR_MAP =3D {
    "2m_temperature": "t2m",
    "2m_dewpoint_temperature": "d2m",
    "100m_u_component_of_wind": "u100",
    "100m_v_component_of_wind": "v100",
    "surface_pressure": "sp",
    "total_precipitation": "tp",
}

TIME_DIM =3D "valid_time"
# =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D
# 5-LEVEL DEEP UNET for RTX 4090 (c1=3D64 =E2=86=92 c5=3D2048, bottleneck=
=3D4096)
# =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D

class ResidualBlock(nn.Module):
    def __init__(self, channels):
        super().__init__()
        self.conv1 =3D nn.Conv2d(channels, channels, kernel_size=3D3, paddi=
ng=3D1)
        self.gn1 =3D nn.GroupNorm(8, channels)
        self.conv2 =3D nn.Conv2d(channels, channels, kernel_size=3D3, paddi=
ng=3D1)
        self.gn2 =3D nn.GroupNorm(8, channels)
        self.act =3D nn.SiLU(inplace=3DTrue)

    def forward(self, x):
        r =3D x
        x =3D self.act(self.gn1(self.conv1(x)))
        x =3D self.act(self.gn2(self.conv2(x)))
        return self.act(x + r)


class SEAttention(nn.Module):
    def __init__(self, channels, reduction=3D8):
        super().__init__()
        hidden =3D max(channels // reduction, 8)
        self.fc1 =3D nn.Conv2d(channels, hidden, 1)
        self.fc2 =3D nn.Conv2d(hidden, channels, 1)
        self.act =3D nn.SiLU()
        self.sig =3D nn.Sigmoid()

    def forward(self, x):
        w =3D x.mean((2,3), keepdim=3DTrue)
        w =3D self.act(self.fc1(w))
        w =3D self.sig(self.fc2(w))
        return x * w


class DownBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super().__init__()
        self.conv =3D nn.Conv2d(in_ch, out_ch, 3, padding=3D1)
        self.norm =3D nn.GroupNorm(8, out_ch)
        self.act =3D nn.SiLU()
        self.res =3D ResidualBlock(out_ch)
        self.attn =3D SEAttention(out_ch)
        self.pool =3D nn.MaxPool2d(2)

    def forward(self, x):
        x =3D self.act(self.norm(self.conv(x)))
        x =3D self.res(x)
        x =3D self.attn(x)
        skip =3D x
        x =3D self.pool(x)
        return x, skip


class UpBlock(nn.Module):
    def __init__(self, in_ch, skip_ch, out_ch):
        super().__init__()
        self.up =3D nn.ConvTranspose2d(in_ch, out_ch, 2, stride=3D2)
        self.res =3D ResidualBlock(out_ch + skip_ch)
        self.attn =3D SEAttention(out_ch + skip_ch)
        self.proj =3D nn.Conv2d(out_ch + skip_ch, out_ch, 1)

    def forward(self, x, skip):
        x =3D self.up(x)
        _, _, H, W =3D x.shape
        skip =3D skip[..., :H, :W]
        x =3D torch.cat([x, skip], 1)
        x =3D self.attn(self.res(x))
        x =3D self.proj(x)
        return x


class ZeusUNet(nn.Module):
    def __init__(self, in_channels, out_channels, base=3D64):
        super().__init__()

        c1 =3D base
        c2 =3D base * 2
        c3 =3D base * 4
        c4 =3D base * 8
        c5 =3D base * 16        # 64*16 =3D 1024 =E2=86=92 but you want 204=
8, so:
        c5 =3D 2048
        cb =3D 4096             # bottleneck

        self.enc1 =3D nn.Sequential(
            nn.Conv2d(in_channels, c1, 3, padding=3D1),
            nn.GroupNorm(8, c1),
            nn.SiLU(),
            ResidualBlock(c1),
            SEAttention(c1),
        )

        self.down1 =3D DownBlock(c1, c2)
        self.down2 =3D DownBlock(c2, c3)
        self.down3 =3D DownBlock(c3, c4)
        self.down4 =3D DownBlock(c4, c5)

        self.bot =3D nn.Sequential(
            nn.Conv2d(c5, cb, 3, padding=3D1),
            nn.GroupNorm(8, cb),
            nn.SiLU(),
            ResidualBlock(cb),
            ResidualBlock(cb),
            SEAttention(cb),
        )

        self.up4 =3D UpBlock(cb, c5, c5)
        self.up3 =3D UpBlock(c5, c4, c4)
        self.up2 =3D UpBlock(c4, c3, c3)
        self.up1 =3D UpBlock(c3, c2, c2)
        self.up0 =3D UpBlock(c2, c1, c1)

        self.out_conv =3D nn.Conv2d(c1, out_channels, 1)

    def forward(self, x):
        B, C, H, W =3D x.shape
        x0 =3D self.enc1(x)
        x1, s1 =3D self.down1(x0)
        x2, s2 =3D self.down2(x1)
        x3, s3 =3D self.down3(x2)
        x4, s4 =3D self.down4(x3)

        xb =3D self.bot(x4)

        x =3D self.up4(xb, s4)
        x =3D self.up3(x, s3)
        x =3D self.up2(x, s2)
        x =3D self.up1(x, s1)
        x =3D self.up0(x, x0)

        return self.out_conv(x)[..., :H, :W]

# -------------------------------------------------------------------------=
-----------
# DATASET
# -------------------------------------------------------------------------=
-----------
class Era5ForecastDataset(Dataset):
    """
    Loads ERA5 NetCDF data for a single variable using xarray,
    applies safety fixes (expver, number) and crops odd-size latitude.
    """

    def __init__(self, files, variable, context_hours, forecast_hours):
        self.variable =3D variable
        self.context =3D context_hours
        self.forecast =3D forecast_hours

        print("[INFO] Loading dataset...")
        era5_var =3D ERA5_VAR_MAP[variable]

        ds =3D xr.open_mfdataset(files, combine=3D"by_coords", engine=3D"h5=
netcdf")[era5_var]
        ds =3D ds.sortby(TIME_DIM)

        # ERA5 ensemble/version dims
        if "number" in ds.dims:
            ds =3D ds.isel(number=3D0)
        if "expver" in ds.dims:
            ds =3D ds.isel(expver=3D0)

        arr =3D ds.values.astype(np.float32)

        # Fix odd-size latitude (e.g., 721 =E2=86=92 720)
        arr =3D arr[:, :-1, :]

        self.values =3D arr
        self.T =3D arr.shape[0]

        print(f"[INFO] Data loaded: time=3D{self.T}, lat=3D{arr.shape[1]}, =
lon=3D{arr.shape[2]}")

    def __len__(self):
        return self.T - self.context - self.forecast

    def __getitem__(self, idx):
        X =3D self.values[idx: idx + self.context]
        Y =3D self.values[idx + self.context: idx + self.context + self.for=
ecast]
        return torch.tensor(X), torch.tensor(Y)


# -------------------------------------------------------------------------=
-----------
# NORMALIZATION
# -------------------------------------------------------------------------=
-----------
def normalize_for_training(variable, dataset_values):
    """Return mean/std OR log1p flag depending on variable."""
    if variable =3D=3D "total_precipitation":
        print("[INFO] Using log1p normalization for precipitation.")
        return {"type": "log1p"}

    mean =3D float(np.nanmean(dataset_values))
    std =3D float(np.nanstd(dataset_values) + 1e-6)
    print(f"[INFO] mean=3D{mean:.5f}, std=3D{std:.5f}")
    return {"type": "z", "mean": mean, "std": std}


class NormWrapper(Dataset):
    """Wraps another dataset and applies normalization per-sample."""
    def __init__(self, base: Dataset, norm: dict):
        self.base =3D base
        self.norm =3D norm

    def __len__(self):
        return len(self.base)

    def __getitem__(self, idx):
        X, Y =3D self.base[idx]

        if self.norm["type"] =3D=3D "log1p":
            return torch.log1p(X), torch.log1p(Y)

        mean, std =3D self.norm["mean"], self.norm["std"]
        return (X - mean) / std, (Y - mean) / std


# -------------------------------------------------------------------------=
-----------
# TRAINING
# -------------------------------------------------------------------------=
-----------
def train(
    variable: str,
    data_glob: str,
    output_dir: str,
    context_hours: int,
    forecast_hours: int,
    batch_size: int,
    epochs: int,
    lr: float,
):
    print("[INFO] Searching ERA5 files...")
    files =3D sorted(glob.glob(data_glob))
    if not files:
        raise RuntimeError(f"No files match: {data_glob}")

    print(f"[INFO] Found {len(files)} files")

    # Load dataset once for stats
    tmp_ds =3D Era5ForecastDataset(files, variable, context_hours, forecast=
_hours)
    stats =3D normalize_for_training(variable, tmp_ds.values)

    # Save normalization config
    os.makedirs(output_dir, exist_ok=3DTrue)
    with open(os.path.join(output_dir, f"norm_{variable}.json"), "w") as f:
        json.dump(stats, f)

    # Dataset + loader
    dataset =3D NormWrapper(tmp_ds, stats)
    loader =3D DataLoader(dataset, batch_size=3Dbatch_size, shuffle=3DTrue,=
 num_workers=3D2)

    device =3D torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print("[INFO] Training on:", device)

    # Model
    model =3D ZeusUNet(
        in_channels=3Dcontext_hours,
        out_channels=3Dforecast_hours,
        base_channels=3D128, # 4090 version; drop to 48 if you ever hit OOM
    ).to(device)

    # Loss
    loss_fn =3D nn.SmoothL1Loss() if variable =3D=3D "total_precipitation" =
else nn.MSELoss()

    # Optimizer + scheduler
    optimizer =3D torch.optim.AdamW(model.parameters(), lr=3Dlr, weight_dec=
ay=3D1e-5)
    scheduler =3D torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=3Depochs, eta_min=3Dlr * 0.1
    )

    scaler =3D amp.GradScaler("cuda")

    # --------------------- TRAIN LOOP ---------------------
    for ep in range(1, epochs + 1):
        model.train()
        losses =3D []

        for X, Y in tqdm(loader, desc=3Df"Epoch {ep}/{epochs}"):
            X, Y =3D X.to(device), Y.to(device)

            optimizer.zero_grad()

            # with amp.autocast("cuda"):
            #     pred =3D model(X)
            #     loss =3D loss_fn(pred, Y)
            pred =3D model(X)

            # Main loss (high resolution)
            loss_main =3D loss_fn(pred, Y)

            # Multi-scale loss (downsampled by factor 2)
            loss_small =3D loss_fn(
                F.avg_pool2d(pred, 2),
                F.avg_pool2d(Y, 2)
            )

            # Combined multi-scale objective
            loss =3D 0.7 * loss_main + 0.3 * loss_small

            # scaler.scale(loss).backward()
            # scaler.unscale_(optimizer)
            # torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            # scaler.step(optimizer)
            # scaler.update()

            loss.backward()
            optimizer.step()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)

            losses.append(loss.item())

        scheduler.step()
        avg_loss =3D sum(losses) / len(losses)
        print(f"[Epoch {ep}] loss=3D{avg_loss:.6f}")

        # Save epoch checkpoint
        ckpt =3D os.path.join(output_dir, f"{variable}_epoch{ep}.pt")
        torch.save(model.state_dict(), ckpt)

    # Final model
    final_path =3D os.path.join(output_dir, f"{variable}.pt")
    torch.save(model.state_dict(), final_path)
    print("[OK] Final model saved:", final_path)


# -------------------------------------------------------------------------=
-----------
# CLI
# -------------------------------------------------------------------------=
-----------
if __name__ =3D=3D "__main__":
    ap =3D argparse.ArgumentParser()
