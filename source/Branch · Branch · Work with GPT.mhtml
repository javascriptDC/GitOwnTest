#!/usr/bin/env python3
import argparse
import json
import os
import glob
import numpy as np
import xarray as xr
import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader
from tqdm import tqdm
import torch.nn.functional as F

ERA5_VAR_MAP =3D {
    "2m_temperature": "t2m",
    "2m_dewpoint_temperature": "d2m",
    "100m_u_component_of_wind": "u100",
    "100m_v_component_of_wind": "v100",
    "surface_pressure": "sp",
    "total_precipitation": "tp",
}

TIME_DIM =3D "valid_time"

class ResidualBlock(nn.Module):
    def __init__(self, channels: int):
        super().__init__()
        self.conv1 =3D nn.Conv2d(channels, channels, kernel_size=3D3, paddi=
ng=3D1)
        self.gn1 =3D nn.GroupNorm(num_groups=3D8, num_channels=3Dchannels)
        self.conv2 =3D nn.Conv2d(channels, channels, kernel_size=3D3, paddi=
ng=3D1)
        self.gn2 =3D nn.GroupNorm(num_groups=3D8, num_channels=3Dchannels)
        self.act =3D nn.SiLU(inplace=3DTrue)

    def forward(self, x):
        residual =3D x
        out =3D self.conv1(x)
        out =3D self.gn1(out)
        out =3D self.act(out)
        out =3D self.conv2(out)
        out =3D self.gn2(out)
        out =3D out + residual
        out =3D self.act(out)
        return out


class DownBlock(nn.Module):
    def __init__(self, in_ch: int, out_ch: int):
        super().__init__()
        self.conv =3D nn.Conv2d(in_ch, out_ch, kernel_size=3D3, padding=3D1=
)
        self.gn =3D nn.GroupNorm(num_groups=3D8, num_channels=3Dout_ch)
        self.act =3D nn.SiLU(inplace=3DTrue)
        self.res =3D ResidualBlock(out_ch)
        self.pool =3D nn.MaxPool2d(kernel_size=3D2, stride=3D2)

    def forward(self, x):
        x =3D self.conv(x)
        x =3D self.gn(x)
        x =3D self.act(x)
        x =3D self.res(x)
        skip =3D x
        x =3D self.pool(x)
        return x, skip


class UpBlock(nn.Module):
    def __init__(self, in_ch: int, skip_ch: int, out_ch: int):
        super().__init__()
        # in_ch from lower level, skip_ch from encoder
        self.up =3D nn.ConvTranspose2d(in_ch, out_ch, kernel_size=3D2, stri=
de=3D2)
        self.res =3D ResidualBlock(out_ch + skip_ch)

        # project back to out_ch after concat+res
        self.proj =3D nn.Conv2d(out_ch + skip_ch, out_ch, kernel_size=3D1)

    def forward(self, x, skip):
        x =3D self.up(x)

        # spatial size alignment (in case of off-by-one)
        _, _, H, W =3D x.shape
        sH, sW =3D skip.shape[2], skip.shape[3]
        if sH !=3D H or sW !=3D W:
            skip =3D skip[..., :H, :W]

        x =3D torch.cat([x, skip], dim=3D1)
        x =3D self.res(x)
        x =3D self.proj(x)
        return x


class ZeusUNet(nn.Module):
    """
    Deeper UNet with residual blocks, GroupNorm, and robust sizing.
    in_channels  =3D context_hours
    out_channels =3D forecast_hours
    base_ch      =3D 32 or 64 (32 is safer for memory)
    """

    def __init__(self, in_channels: int, out_channels: int, base_channels: =
int =3D 32):
        super().__init__()

        ch1 =3D base_channels
        ch2 =3D base_channels * 2
        ch3 =3D base_channels * 4
        ch4 =3D base_channels * 8

        # Encoder
        self.enc_in =3D nn.Conv2d(in_channels, ch1, kernel_size=3D3, paddin=
g=3D1)
        self.enc_in_gn =3D nn.GroupNorm(num_groups=3D8, num_channels=3Dch1)
        self.enc_in_act =3D nn.SiLU(inplace=3DTrue)
        self.enc_res1 =3D ResidualBlock(ch1)

        self.down1 =3D DownBlock(ch1, ch2)
        self.down2 =3D DownBlock(ch2, ch3)

        # Bottleneck
        self.bot_conv =3D nn.Conv2d(ch3, ch4, kernel_size=3D3, padding=3D1)
        self.bot_gn =3D nn.GroupNorm(num_groups=3D8, num_channels=3Dch4)
        self.bot_act =3D nn.SiLU(inplace=3DTrue)
        self.bot_res =3D ResidualBlock(ch4)

        # Decoder
        self.up2 =3D UpBlock(ch4, ch3, ch3)  # from bottleneck, skip enc2
        self.up1 =3D UpBlock(ch3, ch2, ch2)  # from up2, skip enc1
        self.up0 =3D UpBlock(ch2, ch1, ch1)  # from up1, skip enc_in

        # Final projection
        self.out_conv =3D nn.Conv2d(ch1, out_channels, kernel_size=3D1)

    def forward(self, x):
        """
        x: [B, context_hours, H, W]
        returns: [B, forecast_hours, H, W]
        """
        B, C, H, W =3D x.shape

        # Encoder
        x0 =3D self.enc_in(x)
        x0 =3D self.enc_in_gn(x0)
        x0 =3D self.enc_in_act(x0)
        x0 =3D self.enc_res1(x0)      # [B, ch1, H, W]

        x1, skip1 =3D self.down1(x0)  # [B, ch2, H/2, W/2], [B, ch2, H/2, W=
/2]
        x2, skip2 =3D self.down2(x1)  # [B, ch3, H/4, W/4], [B, ch3, H/4, W=
/4]

        # Bottleneck
        xb =3D self.bot_conv(x2)
        xb =3D self.bot_gn(xb)
        xb =3D self.bot_act(xb)
        xb =3D self.bot_res(xb)       # [B, ch4, H/4, W/4] (since padding=
=3D1)

        # Decoder
        x =3D self.up2(xb, skip2)     # [B, ch3, ~H/2, ~W/2]
        x =3D self.up1(x, skip1)      # [B, ch2, ~H, ~W]

        # We need a skip at original resolution; reuse x0
        x =3D self.up0(x, x0)         # [B, ch1, ~H, ~W]

        out =3D self.out_conv(x)      # [B, out_channels, ~H, ~W]

        # Crop to exactly match input H, W (handles odd sizes)
        out =3D out[..., :H, :W]
        return out


