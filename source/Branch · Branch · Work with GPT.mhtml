pan><span class=3D"hljs-number">3</span></span><span>, padding=3D</span><sp=
an><span class=3D"hljs-number">1</span></span><span>)
        self.enc_in_gn =3D nn.GroupNorm(num_groups=3D</span><span><span cla=
ss=3D"hljs-number">8</span></span><span>, num_channels=3Dch1)
        self.enc_in_act =3D nn.SiLU(inplace=3D</span><span><span class=3D"h=
ljs-literal">True</span></span><span>)
        self.enc_res1 =3D ResidualBlock(ch1)

        self.down1 =3D DownBlock(ch1, ch2)
        self.down2 =3D DownBlock(ch2, ch3)

        </span><span><span class=3D"hljs-comment"># Bottleneck</span></span=
><span>
        self.bot_conv =3D nn.Conv2d(ch3, ch4, kernel_size=3D</span><span><s=
pan class=3D"hljs-number">3</span></span><span>, padding=3D</span><span><sp=
an class=3D"hljs-number">1</span></span><span>)
        self.bot_gn =3D nn.GroupNorm(num_groups=3D</span><span><span class=
=3D"hljs-number">8</span></span><span>, num_channels=3Dch4)
        self.bot_act =3D nn.SiLU(inplace=3D</span><span><span class=3D"hljs=
-literal">True</span></span><span>)
        self.bot_res =3D ResidualBlock(ch4)

        </span><span><span class=3D"hljs-comment"># Decoder</span></span><s=
pan>
        self.up2 =3D UpBlock(ch4, ch3, ch3)  </span><span><span class=3D"hl=
js-comment"># from bottleneck, skip enc2</span></span><span>
        self.up1 =3D UpBlock(ch3, ch2, ch2)  </span><span><span class=3D"hl=
js-comment"># from up2, skip enc1</span></span><span>
        self.up0 =3D UpBlock(ch2, ch1, ch1)  </span><span><span class=3D"hl=
js-comment"># from up1, skip enc_in</span></span><span>

        </span><span><span class=3D"hljs-comment"># Final projection</span>=
</span><span>
        self.out_conv =3D nn.Conv2d(ch1, out_channels, kernel_size=3D</span=
><span><span class=3D"hljs-number">1</span></span><span>)

