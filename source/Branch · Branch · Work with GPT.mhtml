</li>
<li data-start=3D"702" data-end=3D"717">
<p data-start=3D"704" data-end=3D"717">Higher loss</p>
</li>
<li data-start=3D"718" data-end=3D"744">
<p data-start=3D"720" data-end=3D"744">Needs many more epochs</p>
</li>
<li data-start=3D"745" data-end=3D"776">
<p data-start=3D"747" data-end=3D"776">Needs careful normalization</p>
</li>
<li data-start=3D"777" data-end=3D"825">
