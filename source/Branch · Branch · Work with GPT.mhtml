        # Fix shape mismatch caused by odd-sized latitude dimension.
        # ERA5 lat=3D721 causes Off-by-1 issues in ConvTranspose2d.
        # We crop 1 latitude row to stabilize CNN operations.
        self.values =3D self.values[:, :-1, :]

        # Time steps
