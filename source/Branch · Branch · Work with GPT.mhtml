        x0 =3D self.enc_res1(x0)      </span><span><span class=3D"hljs-comm=
ent"># [B, ch1, H, W]</span></span><span>

        x1, skip1 =3D self.down1(x0)  </span><span><span class=3D"hljs-comm=
ent"># [B, ch2, H/2, W/2], [B, ch2, H/2, W/2]</span></span><span>
        x2, skip2 =3D self.down2(x1)  </span><span><span class=3D"hljs-comm=
ent"># [B, ch3, H/4, W/4], [B, ch3, H/4, W/4]</span></span><span>

        </span><span><span class=3D"hljs-comment"># Bottleneck</span></span=
><span>
        xb =3D self.bot_conv(x2)
