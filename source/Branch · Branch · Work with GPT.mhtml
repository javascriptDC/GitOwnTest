<li data-start=3D"599" data-end=3D"635">
<p data-start=3D"601" data-end=3D"635">MSE punishes rare spikes heavily</p>
</li>
<li data-start=3D"636" data-end=3D"671">
<p data-start=3D"638" data-end=3D"671">Very sensitive to normalization</p>
</li>
</ul>
<p data-start=3D"673" data-end=3D"680">Expect:</p>
<ul data-start=3D"682" data-end=3D"825">
<li data-start=3D"682" data-end=3D"701">
