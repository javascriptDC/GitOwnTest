# -------------------------------
#  Training function
# -------------------------------
def train(
    variable,
    data_glob,
    output_dir,
    context_hours,
    forecast_hours,
    batch_size,
    epochs,
    lr,
    hidden
):
    print("[INFO] Finding ERA5 files...")
    files =3D sorted(glob.glob(data_glob))
    if len(files) =3D=3D 0:
        raise RuntimeError(f"No files found matching: {data_glob}")

    print(f"[INFO] Using {len(files)} files for variable {variable}")

    # Create dataset
    dataset =3D Era5ForecastDataset(
        files=3Dfiles,
        variable=3Dvariable,
        context_hours=3Dcontext_hours,
        forecast_hours=3Dforecast_hours
    )

    # Compute mean/std for normalization
    print("[INFO] Computing global mean/std...")
    mean =3D float(np.nanmean(dataset.values))
    std =3D float(np.nanstd(dataset.values) + 1e-6)

    os.makedirs(output_dir, exist_ok=3DTrue)
    norm_path =3D os.path.join(output_dir, f"norm_{variable}.json")
    with open(norm_path, "w") as f:
        json.dump({"mean": mean, "std": std}, f)
    print(f"[OK] Saved normalization: {norm_path}")

    # Normalized dataset wrapper
    class NormWrapper(Dataset):
        def __init__(self, base):
            self.base =3D base
        def __len__(self):
            return len(self.base)
        def __getitem__(self, idx):
            X, Y =3D self.base[idx]
            return ( (X - mean)/std, (Y - mean)/std )

    loader =3D DataLoader(NormWrapper(dataset), batch_size=3Dbatch_size, sh=
uffle=3DTrue)

    device =3D torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"[INFO] Training on: {device}")

    # model =3D SimpleUNet(
    #     in_channels=3Dcontext_hours,
    #     out_channels=3Dforecast_hours,
    #     hidden=3Dhidden
