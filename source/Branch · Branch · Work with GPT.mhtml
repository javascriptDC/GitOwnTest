nal resolution; reuse x0</span></span><span>
        x =3D self.up0(x, x0)         </span><span><span class=3D"hljs-comm=
ent"># [B, ch1, ~H, ~W]</span></span><span>

        out =3D self.out_conv(x)      </span><span><span class=3D"hljs-comm=
ent"># [B, out_channels, ~H, ~W]</span></span><span>

        </span><span><span class=3D"hljs-comment"># Crop to exactly match i=
nput H, W (handles odd sizes)</span></span><span>
        out =3D out[..., :H, :W]
        </span><span><span class=3D"hljs-keyword">return</span></span><span=
> out
