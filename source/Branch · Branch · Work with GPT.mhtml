        xb =3D self.bot_act(xb)
        xb =3D self.bot_res(xb)       </span><span><span class=3D"hljs-comm=
ent"># [B, ch4, H/4, W/4] (since padding=3D1)</span></span><span>

        </span><span><span class=3D"hljs-comment"># Decoder</span></span><s=
pan>
        x =3D self.up2(xb, skip2)     </span><span><span class=3D"hljs-comm=
ent"># [B, ch3, ~H/2, ~W/2]</span></span><span>
        x =3D self.up1(x, skip1)      </span><span><span class=3D"hljs-comm=
ent"># [B, ch2, ~H, ~W]</span></span><span>

