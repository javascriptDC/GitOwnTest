><div class=3D"whitespace-pre-wrap">#!/usr/bin/env python3
import cdsapi
import os
import time
import argparse
import subprocess

ZEUS_VARIABLES =3D [
    "2m_temperature",
    "2m_dewpoint_temperature",
    "10m_u_component_of_wind",
    "10m_v_component_of_wind",
    "100m_u_component_of_wind",
    "100m_v_component_of_wind",
    "surface_pressure",
    "total_precipitation",
]


def is_valid_netcdf(path: str) -&gt; bool:
    """Check if file is real NetCDF (HDF5) and not ZIP."""
    if not os.path.exists(path):
        return False

    try:
        out =3D subprocess.check_output(["file", path]).decode()
        return "Hierarchical Data Format" in out or "NetCDF" in out
    except:
        return False


def download_variable_month(variable: str, year: int, month: int, out_dir: =
str):
    """Download a single variable for a single month."""
    file_name =3D f"era5_{year}_{month:02d}_{variable}.nc"
    file_path =3D os.path.join(out_dir, file_name)

    if is_valid_netcdf(file_path):
        print(f"[OK] {file_name} already valid.")
        return

    if os.path.exists(file_path):
        print(f"[WARN] Removing invalid file: {file_path}")
        os.remove(file_path)

    print(f"[INFO] Downloading {variable} for {year}-{month:02d} ...")
    c =3D cdsapi.Client()

    for attempt in range(5):
        try:
            c.retrieve(
                "reanalysis-era5-single-levels",
                {
                    "product_type": "reanalysis",
                    "format": "netcdf",
                    "variable": variable,   # only ONE variable
                    "year": str(year),
                    "month": f"{month:02d}",
                    "day": [f"{d:02d}" for d in range(1, 32)],
                    "time": [f"{h:02d}:00" for h in range(24)],
                },
                file_path,
            )

            if is_valid_netcdf(file_path):
                print(f"[OK] Saved: {file_path}")
                return
            else:
                print("[ERROR] Invalid NetCDF file. Retrying...")
                os.remove(file_path)

        except Exception as e:
            print(f"[WARN] Attempt {attempt+1}/5 failed: {e}")
            time.sleep(5)

    print(f"[FAIL] Could not download {variable} for {year}-{month:02d}")


def main():
    parser =3D argparse.ArgumentParser(description=3D"Safe ERA5 Split Downl=
oader")
    parser.add_argument("--years", nargs=3D"+", required=3DTrue, help=3D"e.=
g., 2020 2021 2022")
    parser.add_argument("--months", nargs=3D"+", required=3DTrue, help=3D"e=
.g., 1 2 3")
    parser.add_argument("--out-dir", required=3DTrue, help=3D"Output direct=
ory")

    args =3D parser.parse_args()

    years =3D [int(y) for y in args.years]
    months =3D [int(m) for m in args.months]

    os.makedirs(args.out_dir, exist_ok=3DTrue)

    for year in years:
        for month in months:
            for var in ZEUS_VARIABLES:
                download_variable_month(var, year, month, args.out_dir)


if __name__ =3D=3D "__main__":
    main()

