# --------------------------------------------------------------
# Zeus Subnet 18 =E2=80=93 Corrected Miner
# Includes: model loading, history fetch, prediction, safety rails
# --------------------------------------------------------------

import time
import torch
import typing
import bittensor as bt
import numpy as np
import openmeteo_requests
import datetime

from zeus.data.converter import get_converter
from zeus.utils.config import get_device_str
from zeus.utils.time import to_timestamp
from zeus.protocol import TimePredictionSynapse
from zeus_version import __version__ as zeus_version

from neurons.miner import BaseMinerNeuron
from model_loader import ZeusModelLoader


class Miner(BaseMinerNeuron):
    """
    Zeus SN18 custom miner using trained ML models instead of Open-Meteo.
    """

    def __init__(self, config=3DNone):
        super().__init__(config=3Dconfig)

        self.device: torch.device =3D torch.device(get_device_str())
        self.openmeteo_api =3D openmeteo_requests.Client()

        # Load all trained UNet models
        self.model_loader =3D ZeusModelLoader(
            models_root=3D"/root/zeus-trained/trained_models",
            context_hours=3D48,
            forecast_hours=3D24,
        )

        bt.logging.info("Miner initialized. Attaching forward/blacklist/pri=
ority.")
        self.axon.attach(
            forward_fn=3Dself.forward,
            blacklist_fn=3Dself.blacklist,
            priority_fn=3Dself.priority,
        )

    # ----------------------------------------------------------
    # Forward Pass
    # ----------------------------------------------------------
    async def forward(self, synapse: TimePredictionSynapse) -&gt; TimePredi=
ctionSynapse:

        coordinates =3D torch.tensor(synapse.locations)
        H, W, _ =3D coordinates.shape

        start_time =3D to_timestamp(synapse.start_time)
        bt.logging.info(
            f"Received request =E2=86=92 {synapse.variable}, "
            f"{synapse.requested_hours}h, grid=3D{coordinates.shape}"
        )

        # ------------------------------------------------------
        # 1. Build 48h context window
        # ------------------------------------------------------
        ctx =3D self.model_loader.context_hours
        history_start =3D start_time - datetime.timedelta(hours=3Dctx)

        converter =3D get_converter(synapse.variable)
        lat, lon =3D coordinates.view(-1, 2).T

        history_params =3D {
            "latitude": lat.tolist(),
            "longitude": lon.tolist(),
            "hourly": converter.om_name,
            "start_hour": history_start.isoformat(timespec=3D"minutes"),
            "end_hour": start_time.isoformat(timespec=3D"minutes"),
        }

        responses =3D self.openmeteo_api.weather_api(
            "https://api.open-meteo.com/v1/forecast",
            params=3Dhistory_params,
            method=3D"POST",
        )

        # ------------------------------------------------------
        # 2. Convert OM =E2=86=92 tensor [48, H, W]
        # ------------------------------------------------------
        raw =3D np.stack(
            [resp.Hourly().Variables(0).ValuesAsNumpy() for resp in respons=
es],
            axis=3D0,  # [H*W, T_hist]
        )

        T_hist =3D raw.shape[1]
        if T_hist &lt; ctx:
            raise RuntimeError(f"History too short ({T_hist} &lt; {ctx})")

        raw =3D raw[:, -ctx:]                # [H*W, 48]
        raw =3D raw.reshape(H, W, ctx)
        raw =3D raw.transpose(2, 0, 1)       # [48, H, W]

        # Convert OM units =E2=86=92 ERA5 units
        hist_era5 =3D converter.om_to_era5(torch.tensor(raw, dtype=3Dtorch.=
float32))
        hist_np =3D hist_era5.cpu().numpy()

        # ------------------------------------------------------
        # 3. Run model =E2=86=92 [F, H, W]
        # ------------------------------------------------------
        pred =3D self.model_loader.predict(
            synapse.variable,
            torch.tensor(hist_np, dtype=3Dtorch.float32),
        )

        # ------------------------------------------------------
        # 4. Safety Rails (very important)
        # ------------------------------------------------------
        output =3D self._sanitize_prediction(
            pred,
            H=3DH,
            W=3DW,
            requested_T=3Dsynapse.requested_hours,
        )

        synapse.predictions =3D output.tolist()
        synapse.version =3D zeus_version
        bt.logging.info(f"Output shape =E2=86=92 {output.shape}")

        return synapse

    # ----------------------------------------------------------
    # SAFETY RAILS =E2=80=93 strict validator-compatible output
    # ----------------------------------------------------------
    def _sanitize_prediction(self, pred, H, W, requested_T):
        """
        Ensures [T, H, W], no NaNs/Infs, valid grid shape.
        """

        # Convert torch =E2=86=92 numpy
        if isinstance(pred, torch.Tensor):
            pred =3D pred.detach().cpu().numpy()

        # Remove batch dim or singleton dims
        if pred.ndim =3D=3D 4 and pred.shape[0] =3D=3D 1:
            pred =3D pred[0]
        if pred.ndim =3D=3D 4 and pred.shape[-1] =3D=3D 1:
            pred =3D pred[..., 0]

        # Must be [T, H, W] shape
        # Fix 2D =E2=86=92 reshape if it's (T, H*W)
        if pred.ndim =3D=3D 2 and pred.shape[1] =3D=3D H * W:
            pred =3D pred.reshape(pred.shape[0], H, W)

        # Trim or pad T dimension
        cur_T =3D pred.shape[0]
        if cur_T &gt; requested_T:
            pred =3D pred[:requested_T]
        elif cur_T &lt; requested_T:
            last =3D pred[-1:]
            missing =3D requested_T - cur_T
            pred =3D np.concatenate([pred, np.repeat(last, missing, axis=3D=
0)], axis=3D0)

        # Fix spatial drift (common ConvTranspose2d bug)
        ph, pw =3D pred.shape[1], pred.shape[2]
        if ph !=3D H or pw !=3D W:
            # Clamp to grid
            pred =3D pred[:, :H, :W]
            # Pad if too small
            if pred.shape[1] &lt; H:
                pad_h =3D H - pred.shape[1]
                pred =3D np.pad(pred, ((0, 0), (0, pad_h), (0, 0)), mode=3D=
"edge")
            if pred.shape[2] &lt; W:
                pad_w =3D W - pred.shape[2]
                pred =3D np.pad(pred, ((0, 0), (0, 0), (0, pad_w)), mode=3D=
"edge")

        # Clean NaN/Inf
        pred =3D np.nan_to_num(pred, nan=3D0.0, posinf=3D1e5, neginf=3D-1e5=
)

        return torch.tensor(pred, dtype=3Dtorch.float32)

    # ----------------------------------------------------------
    # Standard Bittensor methods
    # ----------------------------------------------------------
    async def blacklist(self, synapse):
        return await self._blacklist(synapse)

    async def priority(self, synapse):
        return await self._priority(synapse)


# --------------------------------------------------------------
# MAIN LOOP
# --------------------------------------------------------------
if __name__ =3D=3D "__main__":
    with Miner() as miner:
        while True:
            bt.logging.info(f"Miner running | uid {miner.uid} | {time.time(=
)}")
            time.sleep(30)

