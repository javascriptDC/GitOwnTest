</li>
<li data-start=3D"2862" data-end=3D"2964">
<p data-start=3D"2865" data-end=3D"2880">Then <strong data-start=3D"2870" d=
ata-end=3D"2879">prune</strong>:</p>
<ul data-start=3D"2884" data-end=3D"2964">
<li data-start=3D"2884" data-end=3D"2929">
