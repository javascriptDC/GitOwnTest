<ul data-start=3D"5539" data-end=3D"6485">
<li data-start=3D"5539" data-end=3D"6485">
<p data-start=3D"5541" data-end=3D"5579"><code data-start=3D"5541" data-end=
=3D"5578">CompetitionThread(threading.Thread)</code>:</p>
<ul data-start=3D"5582" data-end=3D"6485">
<li data-start=3D"5582" data-end=3D"5893">
