</li>
<li data-start=3D"911" data-end=3D"985">
<p data-start=3D"914" data-end=3D"922">Outputs:</p>
<ul data-start=3D"926" data-end=3D"985">
<li data-start=3D"926" data-end=3D"944">
<p data-start=3D"928" data-end=3D"944"><code data-start=3D"928" data-end=3D=
"944">model.compiled</code></p>
</li>
<li data-start=3D"948" data-end=3D"965">
<p data-start=3D"950" data-end=3D"965"><code data-start=3D"950" data-end=3D=
"965">settings.json</code></p>
</li>
<li data-start=3D"969" data-end=3D"985">
<p data-start=3D"971" data-end=3D"985"><code data-start=3D"971" data-end=3D=
"983">input.json</code></p>
</li>
</ul>
</li>
<li data-start=3D"986" data-end=3D"1035">
<p data-start=3D"989" data-end=3D"1035">Saves those files into the correct =
directory</p>
</li>
<li data-start=3D"1036" data-end=3D"1076">
<p data-start=3D"1039" data-end=3D"1076">Updates validator configs if neede=
d</p>
</li>
<li data-start=3D"1077" data-end=3D"1114">
